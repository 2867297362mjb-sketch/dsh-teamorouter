{
  "name": "dsh-teamorouter",
  "version": "0.1.0",
  "description": "TeamoRouter provider for DeepSeek Harness: Claude, GPT, Gemini, DeepSeek, Kimi, GLM, Qwen and more through one OpenAI-compatible key, with the model list read live from TeamoRouter's /v1/models.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "teamorouter",
    "llm",
    "openai-compatible"
  ],
  "license": "MIT",
  "homepage": "https://github.com/2867297362mjb-sketch/dsh-teamorouter#readme",
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-llm-pi-ai": ">=0.2.0-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-settings": ">=0.2.0-rc.1 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm-pi-ai": {
      "optional": true
    },
    "@deepseek-ai/dsh-settings": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/2867297362mjb-sketch/dsh-teamorouter.git"
  },
  "bugs": {
    "url": "https://github.com/2867297362mjb-sketch/dsh-teamorouter/issues"
  },
  "author": "TeamoRouter (https://teamorouter.com)"
}
